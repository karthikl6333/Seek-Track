DATABASE_URL=postgres://seek:seek@localhost:5432/seektrack
PORT=3000
# PGSSL=true
# VITE_API_BASE=

# Cloudflare Pages deployment (optional for local dev)
# AUTH_PASSWORD=your-secure-password-here
# AUTH_USER=admin

# Alpaca Paper Trading (required for Live Paper Refresh on Cloudflare Pages)
# ALPACA_API_KEY=your-alpaca-api-key
# ALPACA_SECRET_KEY=your-alpaca-secret-key

# Price Alerts (optional - for email & webhook notifications)
# ALERT_EMAIL_TO=user@example.com
# ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
# RESEND_API_KEY=re_your_resend_api_key_here
# ALERT_EMAIL_FROM=alerts@yourdomain.com
