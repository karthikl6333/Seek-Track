{
  "name": "seek-track",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json && cp server/schema.sql dist-server/schema.sql",
    "prebuild:cf": "node -e \"for (const d of ['dist-cf', '.cf-build']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "build:cf": "npm run build:client && npm run build:server && node scripts/prepare-cf-pages.js",
    "preview": "vite preview",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/index.js",
    "db:up": "docker compose up -d postgres",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@neondatabase/serverless": "^1.1.0",
    "dompurify": "^3.4.17",
    "hono": "^4.7.5",
    "marked": "^18.1.2",
    "pg": "^8.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "sql.js": "^1.14.2",
    "tsx": "^4.19.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.129.0"
  }
}
